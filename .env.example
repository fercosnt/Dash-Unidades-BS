# ===========================================
# Supabase (obrigatorio)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===========================================
# App (obrigatorio)
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# n8n Webhooks (server-side only)
# ===========================================
N8N_WEBHOOK_URL=https://seu-n8n.hostinger.com/webhook
N8N_WEBHOOK_SECRET=seu_webhook_secret_compartilhado

# ===========================================
# Vercel Cron (sync diario Clinicorp)
# ===========================================
# Secret que protege GET /api/cron/clinicorp-sync.
# A Vercel injeta automaticamente como `Authorization: Bearer <CRON_SECRET>`
# nas execucoes do Cron Job. DEVE existir em Production (e exige redeploy
# apos criar/alterar). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=gere_um_hex_de_32_bytes

# ===========================================
# Testes E2E (Playwright) — colocar em .env.e2e (NÃO commitar)
# ===========================================
# Credenciais de usuarios reais de teste (admin + parceiro). Os testes E2E sao
# read-only (login/navegacao/RLS/smoke). Rodar com: npm run test:e2e
# E2E_BASE_URL=http://localhost:3000   # opcional (default localhost:3000)
E2E_ADMIN_EMAIL=admin@exemplo.com
E2E_ADMIN_PASSWORD=
E2E_PARCEIRO_EMAIL=parceiro@exemplo.com
E2E_PARCEIRO_PASSWORD=

# ===========================================
# Telegram (configurar quando bot estiver pronto)
# ===========================================
# TELEGRAM_BOT_TOKEN=seu_bot_token
# TELEGRAM_CHAT_ID=seu_chat_id
